rules_version = '2';

// Paste these into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isTeam() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Team members: one document per person, named by their user ID (added in the console)
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /initiatives/{iid} {
      allow read: if true;
      allow write: if isTeam();

      function isOpen() {
        return get(/databases/$(database)/documents/initiatives/$(iid)).data.status == 'open';
      }

      // What people are bringing — public, no names
      match /pledges/{pid} {
        allow read: if true;
        allow create: if isOpen()
          && request.resource.data.keys().hasOnly(['items', 'extras', 'createdAt'])
          && request.resource.data.items is list && request.resource.data.items.size() <= 100
          && request.resource.data.extras is list && request.resource.data.extras.size() <= 20
          && request.resource.data.createdAt == request.time
          && existsAfter(/databases/$(database)/documents/initiatives/$(iid)/people/$(pid));
        allow update, delete: if isTeam();
      }

      // Who signed up — shown in the list on the event page
      match /people/{pid} {
        allow read: if true;
        allow create: if isOpen()
          && request.resource.data.keys().hasOnly(['name', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
          && request.resource.data.createdAt == request.time
          && existsAfter(/databases/$(database)/documents/initiatives/$(iid)/pledges/$(pid));
        allow update, delete: if isTeam();
      }
    }
  }
}
